# No dotenv is loaded by Python. Compose injects this file explicitly.
NATS_SERVERS=nats://127.0.0.1:4222
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=puda
CLICKHOUSE_PASSWORD=replace-with-the-server-password
CLICKHOUSE_DATABASE=puda
CLICKHOUSE_TABLE=events
CLICKHOUSE_TIMEOUT=30
BATCH_SIZE=1000
BATCH_INTERVAL=1
JS_MAX_ACK_PENDING=4096
# E2EE: all servers must use tls://, set both CA and key file.
# Put e2e.key in a dedicated writable directory (chmod 700) owned by LOGGER_UID.
PUDA_NATS_CA=
PUDA_E2E_KEY_FILE=
PUDA_E2E_KEY_DIR=
LOGGER_UID=10001
LOGGER_GID=10001
