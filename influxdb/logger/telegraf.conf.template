# Telemetry: puda.*.tlm.health
# Wire format varies by machine. Extract shared scalars; drop the raw JSON
# unless nothing could be extracted (InfluxDB points need at least one field).
[[inputs.nats_consumer]]
  name_override = "telemetry"
  servers = ${NATS_SERVERS}
  subjects = ["puda.*.tlm.health"]
  queue_group = "puda_logger_telemetry"
  data_format = "value"
  data_type = "string"

# Extract cpu/mem/temp/connected/status and use the payload timestamp when present.
[[processors.starlark]]
  namepass = ["telemetry"]
  source = '''
load("json.star", "json")
load("time.star", "time")

def as_float(v):
    t = type(v)
    if t == "float":
        return v
    if t == "int":
        return v + 0.0
    return None

def apply(metric):
    raw = metric.fields.get("value")
    if raw == None:
        return metric

    metric.fields.pop("value")

    data = json.decode(raw)
    ts = data.get("timestamp")
    if type(ts) == "string" and len(ts) > 0:
        t = time.parse_time(ts, format="2006-01-02T15:04:05Z07:00", location="UTC")
        metric.time = t.unix_nano

    extracted = 0

    cpu = as_float(data.get("cpu"))
    if cpu != None:
        metric.fields["cpu"] = cpu
        extracted += 1

    mem = as_float(data.get("mem"))
    if mem != None:
        metric.fields["mem"] = mem
        extracted += 1

    temp = as_float(data.get("temp"))
    if temp != None:
        metric.fields["temp"] = temp
        extracted += 1

    connected = data.get("connected")
    if type(connected) == "bool":
        # Store as 0/1 so the 60s mean is the fraction of time connected.
        if connected:
            metric.fields["connected"] = 1.0
        else:
            metric.fields["connected"] = 0.0
        extracted += 1

    status = data.get("status")
    if type(status) == "string" and status != "":
        # Tag so it survives aggregators.mean (string fields are dropped).
        metric.tags["status"] = status
        extracted += 1

    # Keep the raw payload only when none of the shared fields were present.
    if extracted == 0:
        metric.fields["data"] = raw

    return metric
'''

# Prefer response.data for the dashboard Response column when message is empty.
[[processors.starlark]]
  namepass = ["commands"]
  source = '''
def apply(metric):
    data = metric.fields.get("response_data")
    if data == None:
        return metric
    if type(data) != "string":
        data = str(data)
    if data == "" or data == "null":
        metric.fields.pop("response_data")
        return metric
    msg = metric.fields.get("response_message")
    if msg == None or msg == "":
        metric.fields["response_message"] = data
    metric.fields.pop("response_data")
    return metric
'''

# Derive topic from NATS subject: puda.first.cmd.response.queue -> response.queue
[[processors.regex]]
  namepass = ["commands"]
  [[processors.regex.tags]]
    key = "subject"
    pattern = '^puda\.[^.]+\.cmd\.(.+)$'
    replacement = "${1}"
    result_key = "topic"

# Derive machine_id from NATS subject: puda.first.tlm.health -> first
[[processors.regex]]
  namepass = ["telemetry"]
  [[processors.regex.tags]]
    key = "subject"
    pattern = '^puda\.([^.]+)\.tlm\.health$'
    replacement = "${1}"
    result_key = "machine_id"

# Edges publish health at 1 Hz. Persist one 60s mean per series so Influx
# ingest stays tractable as the fleet grows. Commands are not aggregated.
# delay lets in-flight NATS messages join the window that just closed.
[[aggregators.mean]]
  namepass = ["telemetry"]
  period = "60s"
  delay = "5s"
  drop_original = true

[[outputs.influxdb_v2]]
  urls = ["${INFLUXDB_URL}"]
  token = "${INFLUXDB_TOKEN}"
  organization = "${INFLUXDB_ORGANIZATION}"
  bucket = "${INFLUXDB_DATABASE}"
  # subject is 1:1 with machine_id + topic; drop it after regex processors
  # have derived those tags so it is not stored as high-cardinality series.
  tagexclude = ["subject"]
