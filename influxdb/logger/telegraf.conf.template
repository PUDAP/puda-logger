[agent]
  interval = "10s"
  flush_interval = "5s"
  metric_batch_size = 1000
  metric_buffer_limit = 100000

[[inputs.execd]]
  command = ["/opt/puda/bin/python", "/opt/puda/subscriber.py"]
  signal = "none"
  restart_delay = "10s"
  buffer_size = "4MiB"
  data_format = "influx"

[[outputs.influxdb_v2]]
  urls = ["${INFLUXDB_URL}"]
  token = "${INFLUXDB_TOKEN}"
  organization = "${INFLUXDB_ORGANIZATION}"
  bucket = "${INFLUXDB_DATABASE}"
