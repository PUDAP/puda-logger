  data_type = "string"

# ALD runtime health and heartbeat are persisted in ALD_TELEMETRY so they use
# durable JetStream consumers and the same PubAck boundary as point/alarm data.
[[inputs.nats_consumer]]
  name_override = "telemetry"
  servers = ${NATS_SERVERS_TOML}
  credentials = "${NATS_CREDS_FILE}"
  secure = ${NATS_SECURE}
  tls_ca = "${NATS_TLS_CA_FILE}"
  tls_cert = "${NATS_TLS_CERT_FILE}"
  tls_key = "${NATS_TLS_KEY_FILE}"
  insecure_skip_verify = false
  jetstream_subjects = ["puda.*.tlm.ald.health"]
  jetstream_stream = "ALD_TELEMETRY"
  queue_group = "puda_logger_ald_health"
  data_format = "value"
  data_type = "string"

[[inputs.nats_consumer]]
  name_override = "telemetry"
  servers = ${NATS_SERVERS_TOML}
  credentials = "${NATS_CREDS_FILE}"
  secure = ${NATS_SECURE}
  tls_ca = "${NATS_TLS_CA_FILE}"
  tls_cert = "${NATS_TLS_CERT_FILE}"
  tls_key = "${NATS_TLS_KEY_FILE}"
  insecure_skip_verify = false
  jetstream_subjects = ["puda.*.tlm.ald.heartbeat"]
  jetstream_stream = "ALD_TELEMETRY"
  queue_group = "puda_logger_ald_heartbeat"
  data_format = "value"
  data_type = "string"

# Store raw telemetry JSON and use the payload timestamp when present.
[[processors.starlark]]
  namepass = ["telemetry"]
  source = '''
load("json.star", "json")
load("time.star", "time")

def apply(metric):
    raw = metric.fields.get("value")
    if raw == None:
        return metric

    metric.fields["data"] = raw
    metric.fields.pop("value")

    data = json.decode(raw)
    ts = data.get("timestamp")
    if type(ts) == "string" and len(ts) > 0:
        t = time.parse_time(ts, format="2006-01-02T15:04:05Z07:00", location="UTC")
        metric.time = t.unix_nano

    health_fields = [
        "opcua_connected",
        "stale",
        "configured_points",
        "resolved_points",
        "cached_points",
        "sqlite_queue_depth",
        "sqlite_dropped_items",
        "sqlite_writer_ok",
        "sqlite_writer_error_count",
        "sqlite_writer_last_error_type",
        "outbox_pending",
        "outbox_published",
        "outbox_failed_pending",
        "reconnect_count",
        "publisher_error_count",
        "publisher_last_error",
    ]
    for field in health_fields:
        value = data.get(field)
        if value != None:
            metric.fields[field] = value

    return metric
'''

# Stable numeric field for dashboards regardless of the source scalar type.
[[processors.starlark]]
  namepass = ["ald_point", "ald_alarm"]
  source = '''
def apply(metric):
    if "value_float" in metric.fields:
        metric.fields["value_numeric"] = metric.fields["value_float"]
    elif "value_int" in metric.fields:
        metric.fields["value_numeric"] = float(metric.fields["value_int"])
    return metric
'''

# Derive topic from NATS subject: puda.first.cmd.response.queue -> response.queue
[[processors.regex]]
  namepass = ["commands"]
  [[processors.regex.tags]]
    key = "subject"
    pattern = '^puda\.[^.]+\.cmd\.(.+)$'
    replacement = "${1}"
    result_key = "topic"

# Derive machine_id from legacy and ALD health/heartbeat subjects.
[[processors.regex]]
  namepass = ["telemetry"]
  [[processors.regex.tags]]
    key = "subject"
    pattern = '^puda\.([^.]+)\.tlm\.(?:health|ald\.(?:health|heartbeat))$'
    replacement = "${1}"
    result_key = "machine_id"

[[outputs.influxdb_v2]]
  urls = ["${INFLUXDB_URL}"]
  token = "${INFLUXDB_TOKEN}"
  organization = "${INFLUXDB_ORGANIZATION}"
  bucket = "${INFLUXDB_DATABASE}"
