# InfluxDB
INFLUXDB_URL=http://<ip_address>:8181
INFLUXDB_TOKEN=<token>
INFLUXDB_DATABASE=puda
INFLUXDB_ORGANIZATION=bears

# NATS (comma-separated)
NATS_SERVERS=nats://bears:4222,nats://bears:4223,nats://bears:4224

# Optional: if E2EE for NATS is set up
# Set BOTH variables and change all NATS_SERVERS URLs to tls://.
# Paths on your local machine; Compose mounts them into the container automatically.
# PUDA_NATS_CA=/path/to/ca.pem
# PUDA_E2E_KEY_FILE=/path/to/e2e.key
