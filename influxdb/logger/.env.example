# Non-root runtime identity. Set these to the owner of all mode-0400/0600
# file-backed secrets (normally `id -u` / `id -g`).
PUDA_LOGGER_RUNTIME_UID=
PUDA_LOGGER_RUNTIME_GID=

# InfluxDB
INFLUXDB_URL=http://<ip_address>:8181
INFLUXDB_TOKEN_PATH=./secrets/influxdb-write-token
INFLUXDB_DATABASE=machines
INFLUXDB_ORGANIZATION=bears

# Immutable production logger image. Digest is sha256 plus 64 lowercase hex.
PUDA_LOGGER_IMAGE_REPOSITORY=registry.internal.example/puda/influxdb-logger
PUDA_LOGGER_IMAGE_DIGEST=sha256:<64-hex-release-digest>

# NATS production endpoints (comma-separated; do not put userinfo in URLs).
NATS_SERVERS=tls://nats-1.example.internal:4222,tls://nats-2.example.internal:4222,tls://nats-3.example.internal:4222
NATS_TIMEOUT=5s
NATS_STREAM_REPLICAS=3
NATS_ALLOW_UNAUTHENTICATED_LOOPBACK=0

# Host secret sources consumed by Docker Compose. Keep these files mode 0400
# and out of Git/build context.
NATS_CREDS_PATH=./secrets/nats.creds
NATS_TLS_CA_PATH=./secrets/nats-ca.pem
NATS_TLS_CERT_PATH=./secrets/nats-client-cert.pem
NATS_TLS_KEY_PATH=./secrets/nats-client-key.pem

# Read-only paths inside both containers. Leave a TLS variable unset/empty only
# when that TLS file is intentionally not used.
NATS_CREDS_FILE=/run/secrets/nats.creds
NATS_TLS_CA_FILE=/run/secrets/nats-ca.pem
NATS_TLS_CERT_FILE=/run/secrets/nats-client-cert.pem
NATS_TLS_KEY_FILE=/run/secrets/nats-client-key.pem
