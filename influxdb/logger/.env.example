# InfluxDB
INFLUXDB_URL=http://<ip_address>:8181
INFLUXDB_TOKEN=<token>
INFLUXDB_DATABASE=puda
INFLUXDB_ORGANIZATION=bears

# NATS (comma-separated; stream init uses the first entry)
NATS_SERVERS=nats://bears:4222,nats://bears:4223,nats://bears:4224

# Logger replicas (NATS queue groups split ingest; no duplicate writes).
# Start at 1 per 10–20k machines. Increase if Telegraf CPU is pegged or
# logs show "metric buffer overflow" / discarded metrics (metric_buffer_limit).
LOGGER_REPLICAS=1
