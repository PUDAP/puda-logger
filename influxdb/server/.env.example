# Database the logger writes to (last-value cache is created here).
INFLUXDB_DATABASE=puda 

# InfluxDB server
INFLUXDB_PORT=8181
INFLUXDB3_NODE_IDENTIFIER_PREFIX=puda
INFLUXDB3_LOG_FILTER=info
INFLUXDB3_ADMIN_TOKEN_FILE=/run/secrets/admin-token
INFLUXDB_TOKEN=<token>
# 3.11 authenticates /health by default; Docker probes have no token.
INFLUXDB3_DISABLE_AUTHZ=health

# Ingest / query tuning (InfluxDB 3 Core). Default IO threads are 2 and
# bottleneck writes. 8 is the starting point for mixed Grafana + ingest;
# use 4 on a small NAS, 12–16 on a 32-core write-heavy box.
INFLUXDB3_NUM_IO_THREADS=8
INFLUXDB3_WAL_FLUSH_INTERVAL=100ms
INFLUXDB3_EXEC_MEM_POOL_BYTES=70%
INFLUXDB3_CHECKPOINT_INTERVAL=1h
# Parquet cache for dashboard queries (3.9 name). 1gb; lower if RAM is tight.
INFLUXDB3_PARQUET_MEM_CACHE_SIZE=1gb

# Last-value cache on telemetry(machine_id). Created after the first health write.
INFLUXDB_LAST_CACHE_NAME=telemetry_last
INFLUXDB_LAST_CACHE_TTL=10min
